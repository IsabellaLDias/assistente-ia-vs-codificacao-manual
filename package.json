{
  "name": "lab02-metricas-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node web/server.mjs",
    "test:web": "node --test web/server.test.mjs",
    "build": "node --check web/server.mjs && node --check web/public/app.js && node --check web/public/shell.js && node --check web/public/dashboard.js && node --check cronometro/script.js",
    "data:dashboard": "python3 scripts/generate-dashboard-data.py",
    "plots": ".venv/bin/python scripts/generate_plots.py",
    "docker:build": "docker build -t lab02-metricas .",
    "docker:run": "docker run -p 3010:3010 lab02-metricas"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0"
  }
}
